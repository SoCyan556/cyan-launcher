<Window x:Class="CyanLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyan Civilization Launcher" Width="920" Height="620" MinWidth="720" MinHeight="480"
        Icon="pack://application:,,,/Assets/CyanLauncher.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="AccountText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="SignInButton" Content="Sign in with Microsoft" Click="SignIn_Click"/>
                    <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click" Visibility="Collapsed" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/icon-256.png" Width="44" Height="44" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cyan Civilization" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}"/>
                <ProgressBar x:Name="Progress" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="0"
                             Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Background="{StaticResource Bg}" BorderThickness="0" Padding="20" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Play">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="PlayButton" Content="Install Cyan Civilization" Style="{StaticResource PrimaryButton}" Click="Play_Click"/>
                            <Button x:Name="CheckButton" Content="Check for updates" Click="Check_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="DeviceCodePanel" Visibility="Collapsed" Margin="0,18,0,0" Padding="14" CornerRadius="6"
                                Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Finish signing in" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DeviceCodeText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Open sign-in page" Click="OpenDeviceLink_Click"/>
                                    <Button Content="Copy code" Click="CopyCode_Click"/>
                                    <Button Content="Cancel" Click="CancelSignIn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,18,0,0" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                </Grid>
            </TabItem>

            <TabItem Header="Mods">
                <DockPanel>
                    <TextBlock x:Name="ModsHint" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <DataGrid x:Name="ModsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                              Background="{StaticResource Panel}" RowBackground="{StaticResource Panel}"
                              AlternatingRowBackground="{StaticResource Bg}" Foreground="{StaticResource Fg}"
                              BorderBrush="{StaticResource Line}" HorizontalGridLinesBrush="{StaticResource Line}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource Bg}"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding ClientSide}"
                                                  HorizontalAlignment="Center" Click="ModToggle_Click" Tag="{Binding Path}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mod" Binding="{Binding DisplayName}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Game folder" FontWeight="SemiBold"/>
                        <TextBlock Text="Where mods, settings and worlds live. Leave as is unless you want to use another folder." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,6,0,16">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseGameDir_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="GameDirBox"/>
                        </DockPanel>

                        <TextBlock Text="Memory (MB)" FontWeight="SemiBold"/>
                        <TextBox x:Name="MemoryBox" Width="120" HorizontalAlignment="Left" Margin="0,6,0,16"/>

                        <TextBlock Text="Java (javaw.exe)" FontWeight="SemiBold"/>
                        <TextBlock Text="Leave empty and the launcher downloads and manages the right Java for you." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,6,0,16">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseJava_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="JavaBox"/>
                        </DockPanel>

                        <TextBlock Text="Update source (pack.json URL)" FontWeight="SemiBold"/>
                        <TextBox x:Name="ManifestBox" Margin="0,6,0,16"/>

                        <TextBlock Text="Microsoft sign-in client ID" FontWeight="SemiBold"/>
                        <TextBlock Text="Azure app registration approved for Minecraft. Only change this if you know you need to." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <TextBox x:Name="ClientIdBox" Margin="0,6,0,16"/>

                        <TextBlock Text="Offline name (testing only)" FontWeight="SemiBold"/>
                        <TextBlock Text="Used for Play when you are not signed in. Singleplayer only; servers will reject it." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <TextBox x:Name="OfflineBox" Width="220" HorizontalAlignment="Left" Margin="0,6,0,16"/>

                        <CheckBox x:Name="CloseOnLaunchBox" Content="Close the launcher when the game starts" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button Content="Save settings" Click="SaveSettings_Click"/>
                            <Button Content="Open game folder" Click="OpenGameDir_Click"/>
                        </StackPanel>

                        <TextBlock Text="Maintenance" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="RepairButton" Content="Repair pack files" Click="Repair_Click"/>
                            <Button x:Name="ResetButton" Content="Reset to Cyan defaults…" Click="Reset_Click"/>
                        </StackPanel>
                        <TextBlock Text="Reset overwrites your settings, keybinds and mod configs with the Cyan defaults. Worlds, waypoints and accounts are never touched."
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
