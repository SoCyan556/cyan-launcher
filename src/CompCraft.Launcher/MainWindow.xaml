<Window x:Class="CompCraft.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Comp Craft" Width="1240" Height="720" MinWidth="980" MinHeight="600"
        Icon="pack://application:,,,/Assets/CompCraft.ico" WindowStyle="None" ResizeMode="CanResize" Background="#141110" WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#141110"/>
</Window>
